POST {{BASE_URL}}/contacts
Content-Type: application/json

{
  "firstName": "Nana",
  "lastName": "Adjei",
  "email": "nana.adjei@example.com",
  "favoriteColor": "orange",
  "birthday": "1997-06-18"
}

